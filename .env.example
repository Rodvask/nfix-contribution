# Postgres
POSTGRES_DB=nfix
POSTGRES_USER=nfix
POSTGRES_PASSWORD=change-me

# Public dashboard port
API_PORT=8090

# Token required for the detailed (per-trade) endpoints. Empty = endpoints disabled.
DASHBOARD_TOKEN=

# Hide aggregates coming from fewer installations than this (k-anonymity floor)
MIN_INSTALLS=3

# Discord ingestion: the bot reads the channel where the daily nfi-report-*.json land.
# Create the bot in https://discord.com/developers/applications (Bot -> Reset Token),
# enable "Message Content Intent" is NOT required for attachments, invite it to the
# server with "View Channel" + "Read Message History".
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# How often to poll Discord (seconds)
POLL_SECONDS=900
# How many messages to walk back the first time (100 per request)
INITIAL_LOOKBACK=200
